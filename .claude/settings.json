{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./ra:*)",
      "Bash(bash ra:*)",
      "Bash(bash ./ra:*)",
      "Bash(git -C papers/:*)",
      "Bash(latexmk:*)",
      "Bash(latexdiff:*)",
      "Bash(texcount:*)",
      "Bash(pdfinfo:*)",
      "Bash(dot:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(rm -rf:*)",
      "Edit(papers/*/state.json)",
      "Edit(**/*.bib)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/ra\" hook session-start", "timeout": 30 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/ra\" hook prompt", "timeout": 60 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/ra\" hook pre-edit", "timeout": 30 }
        ]
      },
      {
        "matcher": "Read|Glob|Grep|NotebookRead",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/ra\" hook pre-read", "timeout": 30 }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/ra\" hook pre-bash", "timeout": 30 }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/ra\" hook pre-skill", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/ra\" hook post-edit", "timeout": 300 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/ra\" hook stop", "timeout": 30 }
        ]
      }
    ]
  }
}
