{
  "ra-guard": {
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|read_file|run_command|invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "bash run_hook.sh pre-tool",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash run_hook.sh post-tool",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "bash run_hook.sh session-start",
        "timeout": 30
      }
    ]
  }
}
